# ==============================================================================
# InvestAI - Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="InvestAI Portfolio & Risk Platform"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32_chars_min

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=investai_db

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Default Financial / Risk Parameters
DEFAULT_MAX_ASSET_CONCENTRATION_PCT=15.0
DEFAULT_MAX_SECTOR_CONCENTRATION_PCT=30.0
DEFAULT_REBALANCE_TOLERANCE_BAND_PCT=5.0

